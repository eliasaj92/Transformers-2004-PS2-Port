+bool GSRendererHW::DrawNativeTriangles(const GSVertexTrace::Vertex& minimum, const GSVertexTrace::Vertex& maximum,
+	const u16* indices, u32 nindices, u32 nverts, bool nonconstant_depth, void* context,
+	bool (*submit)(void*, GSHWDrawConfig&), void (*materialize)(void*, GSVertex*, u32))
+{
+	if (!indices || !nindices || nindices % 3 || nverts < 3 || nverts > 65532 || nindices > 65532 ||
+		!nonconstant_depth || !submit || !materialize || m_native_materialize ||
+		GSUtil::GetPrimClass(m_env.PRIM.PRIM) != GS_TRIANGLE_CLASS || !m_env.PRIM.IIP ||
+		m_env.PRIM.FST || m_env.PRIM.AA1 || m_gsc || m_oi || GSConfig.UserHacks_RewriteLargeSTCoords ||
+		GSConfig.UserHacks_Limit24BitDepth == GSLimit24BitDepth::PrioritizeUpper)
+		return false;
+	for (u32 i = 0; i < nindices; ++i)
+		if (indices[i] >= nverts)
+			return false;
+	for (u32 i = 0; i < 4; ++i)
+		if (!std::isfinite(minimum.p.F32[i]) || !std::isfinite(maximum.p.F32[i]) ||
+			!std::isfinite(minimum.t.F32[i]) || !std::isfinite(maximum.t.F32[i]) ||
+			minimum.p.F32[i] > maximum.p.F32[i] || minimum.t.F32[i] > maximum.t.F32[i] ||
+			minimum.c.I32[i] < 0 || maximum.c.I32[i] > 255 || minimum.c.I32[i] > maximum.c.I32[i])
+			return false;
+	if (minimum.t.z <= 0.0f || maximum.t.z >= 1e30f || minimum.t.z != minimum.t.w || maximum.t.z != maximum.t.w ||
+		minimum.p.x < -4096.0f || minimum.p.y < -4096.0f || maximum.p.x > 4096.0f || maximum.p.y > 4096.0f ||
+		minimum.p.z < 0.0f || maximum.p.z > 16777215.0f || minimum.p.w < 0.0f || maximum.p.w > 255.0f)
+		return false;
+
+	Flush(GSFlushReason::CONTEXTCHANGE);
+	if (m_channel_shuffle || m_channel_shuffle_width || m_split_clear_pages || m_split_texture_shuffle_pages ||
+		m_vertex->tail > 2 || m_index->tail)
+		return false;
+	// Conservative boxes can create a differently sized cold target, changing
+	// the viewport's floating-point interpolation. Require an established target
+	// covering this scissor until cold-target preparation has been qualified.
+	const u32 frame_base = m_context->FRAME.Block();
+	const auto* target = g_texture_cache->GetExactTarget(frame_base, m_context->FRAME.FBW,
+		GSTextureCache::RenderTarget, frame_base + 1);
+	if (!target || !target->m_texture || target->m_TEX0.TBP0 != frame_base ||
+		target->m_unscaled_size.x < m_context->scissor.in.z || target->m_unscaled_size.y < m_context->scissor.in.w)
+		return false;
+	while (m_max_vertex_count < std::max(nverts, nindices))
+		GrowVertexBuffer();
+
+	const GSVertexBuff saved = *m_vertex;
+	GSVertex remaining[2];
+	std::memcpy(remaining, saved.buff, sizeof(GSVertex) * saved.tail);
+	const ScopedGuard restore([&] {
+		m_native_vertices_pending = false;
+		m_native_geometry_context = nullptr;
+		m_native_submit = nullptr;
+		m_native_materialize = nullptr;
+		*m_vertex = saved;
+		m_index->tail = 0;
+		std::memcpy(saved.buff, remaining, sizeof(GSVertex) * saved.tail);
+	});
+	std::memcpy(m_index->buff, indices, sizeof(u16) * nindices);
+	m_vertex->head = m_vertex->tail = m_vertex->next = nverts;
+	m_index->tail = nindices;
+	m_native_geometry_context = context;
+	m_native_submit = submit;
+	m_native_materialize = materialize;
+	m_native_vertices_pending = true;
+	m_native_min = minimum;
+	m_native_max = maximum;
+	// Needs proper testing with ordered live VIF/GIF ownership before enabling
+	// runtime bypass. This scoped API deliberately does not synthesize latches.
+	FlushPrim();
+	return true;
+}
