+bool GSDevice12::RenderHWFromGPU(GSHWDrawConfig& config, const D3D12_VERTEX_BUFFER_VIEW& vertices)
+{
+	// Expanded primitives read a different vertex stream in the vertex shader.
+	// Start with ordinary indexed triangles; do not silently bind the CPU stream.
+	if (m_native_geometry_vertices.BufferLocation || !vertices.BufferLocation ||
+		(vertices.BufferLocation & 31u) || vertices.StrideInBytes != sizeof(GSVertex) ||
+		!config.nverts || config.nverts > vertices.SizeInBytes / sizeof(GSVertex) ||
+		!config.indices || !config.nindices || config.nindices % 3u ||
+		config.topology != GSHWDrawConfig::Topology::Triangle ||
+		config.vs.expand != GSHWDrawConfig::VSExpand::None || config.line_expand)
+		return false;
+	for (u32 i = 0; i < config.nindices; i++)
+	{
+		if (config.indices[i] >= config.nverts)
+			return false;
+	}
+
+	struct ResetNativeInput
+	{
+		D3D12_VERTEX_BUFFER_VIEW& view;
+		~ResetNativeInput() { view = {}; }
+	} reset{m_native_geometry_vertices};
+	m_native_geometry_vertices = vertices;
+	RenderHW(config);
+	return true;
+}
